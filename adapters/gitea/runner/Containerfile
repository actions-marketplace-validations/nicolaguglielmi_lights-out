# The Gitea Actions runner in host mode: the workbench image plus the
# runner binary, so a job running `./go ci` finds every tool already there
# and needs no engine socket (docs/adr/0012 §3). WORKBENCH_IMAGE is the
# cksum-tagged image ./go built; compose passes it as a build arg.
ARG WORKBENCH_IMAGE
FROM docker.gitea.com/runner:3.4.2@sha256:50c352f0506b1878be93f2e9e97353cd6261cd2e7f7bfe70fcd968d00874f9f9 AS upstream
FROM ${WORKBENCH_IMAGE}
COPY --from=upstream /usr/local/bin/gitea-runner /usr/local/bin/gitea-runner
COPY --from=upstream /usr/local/bin/run.sh /usr/local/bin/run.sh
COPY config.yaml /etc/gitea-runner/config.yaml
RUN gitea-runner --version
ENV CONFIG_FILE=/etc/gitea-runner/config.yaml
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/run.sh"]
