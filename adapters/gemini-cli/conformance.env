# What gates/harness-conformance.sh needs to know about this harness
# (docs/adr/0041 §8): the gate itself names no provider, model or key
# (docs/adr/0040 §5).
# The provider this harness runs (docs/adr/0041 §2).
PROVIDER=gemini
# The id the suite requests: the profile's (profiles/l1.env, docs/adr/0040 §1).
MODEL=gemini-3.8-flash
# The .env variable holding the key (docs/adr/0040 §1).
KEY_VAR=GEMINI_API_KEY
# Where the request carries thinking.env's value: the model alias's
# generateContentConfig.thinkingConfig, as the Gemini API receives it
# (entrypoint.sh's alias; checked against the scripted model, 2026-11-04).
THINKING_PATH=.generationConfig.thinkingConfig.thinkingLevel
# The only host:port pairs the egress proxy opens for this harness
# (docs/adr/0046 §4), the ones it asked for with an empty allowlist
# (verified 2026-11-04); play.googleapis.com, its usage statistics, was
# denied and no run failed for it.
EGRESS=generativelanguage.googleapis.com:443
