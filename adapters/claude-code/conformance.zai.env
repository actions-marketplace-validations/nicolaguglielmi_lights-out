# The claude-code harness's second provider (docs/adr/0092 §2, §3): GLM by
# Z.ai through its Anthropic-compatible endpoint. Read by run.sh when
# MODEL_PROVIDER=zai, and by gates/harness-conformance.sh, which runs the
# eleven cases once more with it.
# The provider (docs/adr/0092 §1).
PROVIDER=zai
# The id the suite requests: .env.example's GLM pair, Z.ai's current
# flagship (docs.z.ai/guides/llm/glm-5.3, read 2026-11-16).
MODEL=glm-5.3
# The .env variable holding the key, LiteLLM's name for it; run.sh hands
# it to Claude Code as ANTHROPIC_AUTH_TOKEN (docs/adr/0092 §3).
KEY_VAR=ZAI_API_KEY
# Where the request carries thinking.env's value: Claude Code 2.1.311 sends
# --effort as output_config.effort for this model too (verified 2026-11-16
# against a local listener); whether Z.ai honours it is not documented.
THINKING_PATH=.output_config.effort
# The only host:port the egress proxy opens for this provider (docs/adr/0046 §4).
EGRESS=api.z.ai:443
# The Anthropic-compatible base URL Z.ai documents for Claude Code
# (docs.z.ai/scenario-example/develop-tools/claude, read 2026-11-16).
BASE_URL=https://api.z.ai/api/anthropic
