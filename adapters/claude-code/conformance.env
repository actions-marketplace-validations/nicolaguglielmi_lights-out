# What gates/harness-conformance.sh needs to know about this harness
# (docs/adr/0041 §8): the gate itself names no provider, model or key
# (docs/adr/0040 §5).
# The provider this harness runs (docs/adr/0041 §2).
PROVIDER=anthropic
# The id the suite requests: ADR 0040 §1's Anthropic pair.
MODEL=claude-sonnet-5-5
# The .env variable holding the key (docs/adr/0040 §1).
KEY_VAR=ANTHROPIC_API_KEY
# Where the request carries thinking.env's value (verified 2026-11-04).
THINKING_PATH=.output_config.effort
