# What gates/harness-conformance.sh needs to know about this harness
# (docs/adr/0041 §8): the gate itself names no provider, model or key
# (docs/adr/0040 §5).
# The provider this harness runs (docs/adr/0041 §2).
PROVIDER=openai
# The id the suite requests: ADR 0040 §1's OpenAI pair.
MODEL=gpt-6.1-sol
# The .env variable holding the key (docs/adr/0040 §1); the service hands
# it to codex as CODEX_API_KEY (compose.yaml).
KEY_VAR=OPENAI_API_KEY
# Where the request carries thinking.env's value (verified 2026-11-04).
THINKING_PATH=.reasoning.effort
