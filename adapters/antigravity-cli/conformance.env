# What gates/harness-conformance.sh needs to know about this harness
# (docs/adr/0041 §8): the gate itself names no provider, model or key
# (docs/adr/0040 §5).
# The provider this harness runs: gemini, like gemini-cli (docs/adr/0050 §1).
PROVIDER=gemini
# The id the suite requests: the profile's (profiles/l1.env, docs/adr/0040 §1).
MODEL=gemini-3.8-flash
# The .env variable holding the key (docs/adr/0040 §1).
KEY_VAR=GEMINI_API_KEY
# Where the request carries thinking.env's value (verified 2026-11-05 against
# a scripted model, docs/adr/0050 "Verified").
THINKING_PATH=.generationConfig.thinkingConfig.thinkingLevel
# The only host:port the egress proxy opens for this harness (docs/adr/0046
# §4). Verified 2026-11-05 with an empty allowlist: agy also asks for
# play.googleapis.com:443 (usage statistics) and
# antigravity-cli-auto-updater-974169037036.us-central1.run.app:443 (its
# self-update check) on every run; both denied, no run failed for it, and
# the second denial is what keeps the pinned binary pinned (docs/adr/0050 §2).
EGRESS=generativelanguage.googleapis.com:443
