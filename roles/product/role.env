# Budgets for the product role, an ADK role (docs/adr/0020 §1, §3). HARNESS
# names the AgentHarness adapter this role runs on regardless of the
# profile's AGENT_HARNESS, which selects the coding roles' harness; the
# model is still the profile's (replay at L0). THINKING from plan §5's
# table ("conversazione, non esecuzione"). TIMEOUT_S: plan §2, the one
# wall-clock figure with provenance (the ADR 0017 §8 precedent). No
# TOKEN_BUDGET yet: run.json records the first real numbers and a
# dedicated commit sets one from them.
HARNESS=adk
THINKING=medium
TIMEOUT_S=900
# The model turns one ADK run may take, the whole conversation counted
# (docs/adr/0090, amendment A1).
# Provenance, decision: two turns per question (the call and its sentence)
# at the interview's cap of five, 10, plus a proposal of up to five tickets
# one call per turn and its sentence, 6; measured 2, 4 and 6 in the three
# recordings (the 6: two questions, both tickets proposed in one turn).
ADK_MAX_TURNS=16
