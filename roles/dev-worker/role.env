# Budgets for the dev-worker role (docs/adr/0017 §7, §8). THINKING from
# plan §5's table ("task lungo, molti tool, va verificato"). MAX_TURNS,
# TIMEOUT_S and TOKEN_BUDGET are dev-worker's alone: the only role with a
# run at M5 (docs/adr/0017 §7).
THINKING=high

# 250 requests/day (Gemini API free tier, external constraint) divided by
# four attempts per day (decision): a headless turn is a request.
MAX_TURNS=60

# Decision: the one wall-clock figure this repo has with provenance (plan
# §2). Revisited by a dedicated commit if the measured duration
# contradicts it.
TIMEOUT_S=900

# Decision: a cost ceiling of about $3 per run at the introductory price
# ($0.75/M in, $3.75/M out) for a realistic 95/5 input/output split,
# because cumulative input re-sends the context every turn. The free tier
# makes this moot; a paid key does not.
TOKEN_BUDGET=4000000
