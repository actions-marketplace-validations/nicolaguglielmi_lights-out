# Budgets for the dev-worker role (docs/adr/0017 §7, §8). THINKING from
# plan §5's table ("task lungo, molti tool, va verificato"). MAX_TURNS,
# TIMEOUT_S and TOKEN_BUDGET are dev-worker's alone: the only role with a
# run at M5 (docs/adr/0017 §7).
THINKING=high

# 250 requests/day (Gemini API free tier, external constraint) divided by
# four attempts per day (decision): a headless turn is a request.
MAX_TURNS=60

# Decision: the one wall-clock figure this repo has with provenance (plan
# §2). Revisited by a dedicated commit if the measured duration
# contradicts it. Checked at M6 against ADR 0018's run 3: 557 s for 43
# calls, ~13 s per call, so MAX_TURNS=60 fits inside it (~780 s).
TIMEOUT_S=900

# Provenance, measurement over decision: the M5 record run's fixture
# attempt (docs/adr/0017) spent 4,193,082 tokens on 29 tool calls that
# correctly touched every file the ticket needed, then had its one
# remaining turn — writing the PR text — denied by the original
# 4,000,000 ceiling with no work left to do. Raised to that measurement
# plus one more full turn's headroom (roughly 800,000 tokens, the
# heaviest single turn observed, mostly cached repeat context) rounded
# up. At the introductory price ($0.75/M in, $3.75/M out) this is still
# under $4 for a 95/5 input/output split; the free tier makes it moot
# either way.
#
# Re-measured 2026-09-16 on the model docs/adr/0018 pinned, with THINKING=high really
# applied for the first time (docs/adr/0018): the first agentic run on
# that model accumulated 7,575,131 tokens over 38 tool calls — about
# 200,000 per call of mostly cached repeat context, against ~140,000 on
# the 3.5 run — and was denied at the old 5,000,000 before its first
# edit. Doubled to cover that measurement plus the ~12 calls of real work
# the 3.5 run needed; ~$8 at the introductory price, still free-tier.
#
# MEASURED (M9, docs/adr/0021 §6, closing the M6 provisional condition
# above): two successful `./go record PROFILE=l1` runs under the ticket
# 0004 prompt — ticket 0001's re-record (2,435,115 tokens, 32 tool calls,
# 328 s) and ticket 0005's medium-risk PR (1,823,982 tokens, 34 tool
# calls, 249 s), both single-shot: no run needed a follow-up turn, no run
# touched the mutation suite. The rewritten prompt itself is most of the
# drop from the M6 figures above (10.7M/7.6M) to under 2.5M — ticket 0004
# was right about the cause. Budget = the larger total (2,435,115) plus
# one more call's headroom at that run's own per-call cost (2,435,115 /
# 32 ≈ 76,097), rounded up: 2,511,212 → 2,600,000.
TOKEN_BUDGET=2600000
