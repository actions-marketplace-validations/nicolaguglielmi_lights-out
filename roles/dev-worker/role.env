# Budgets for the dev-worker role (docs/adr/0017 §7, §8). THINKING from
# plan §5's table ("task lungo, molti tool, va verificato"). MAX_TURNS,
# TIMEOUT_S and TOKEN_BUDGET are dev-worker's alone: the only role with a
# run at M5 (docs/adr/0017 §7).
THINKING=high

# 250 requests/day (Gemini API free tier, external constraint) divided by
# four attempts per day (decision): a headless turn is a request.
MAX_TURNS=60

# Decision: the one wall-clock figure this repo has with provenance (plan
# §2). Revisited by a dedicated commit if the measured duration
# contradicts it.
TIMEOUT_S=900

# Provenance, measurement over decision: the M5 record run's fixture
# attempt (docs/adr/0017) spent 4,193,082 tokens on 29 tool calls that
# correctly touched every file the ticket needed, then had its one
# remaining turn — writing the PR text — denied by the original
# 4,000,000 ceiling with no work left to do. Raised to that measurement
# plus one more full turn's headroom (roughly 800,000 tokens, the
# heaviest single turn observed, mostly cached repeat context) rounded
# up. At the introductory price ($0.75/M in, $3.75/M out) this is still
# under $4 for a 95/5 input/output split; the free tier makes it moot
# either way.
TOKEN_BUDGET=5000000
