# Budgets for the test-reviewer role (docs/adr/0021 §7). THINKING from plan
# §5's table ("deve trovare quello che l'autore non ha visto").
THINKING=high

# MEASURED (M9, docs/adr/0021 §7): the recorded run (`./go record-review
# TICKET=0005 PROFILE=l1`), reviewing ticket 0005's real PR — 1,154,977
# tokens, 27 tool calls, 123 s. Plan §5's expectation (fewer calls than a
# writing role) held: about half of dev-worker's measured budget.
# TOKEN_BUDGET = this run's total plus one more call's headroom at its
# own per-call cost (1,154,977 / 27 ≈ 42,777), rounded up generously:
# 1,197,754 → 1,500,000 (found live: a same-role re-run of the harness
# after a `demo-review` attempt cost noticeably more per call on a
# slightly different diff — the margin here trades a little on the low
# side for staying inside a single measured run's own number). MAX_TURNS
# and TIMEOUT_S stay dev-worker's external/plan-provenance numbers
# (docs/adr/0017 §7, §8): this run used 1 of 60 turns and 123 of 900 s,
# so neither is close to binding, and there is no separate measurement to
# replace them with.
MAX_TURNS=60
TIMEOUT_S=900
TOKEN_BUDGET=1500000
