# Budgets for the architect role (docs/adr/0021 §7). THINKING from plan
# §5's table ("poche chiamate, alto impatto").
THINKING=high

# MEASURED (M9, docs/adr/0021 §7): the one exercised run (`./go
# record-review TICKET=0005 ROLE=architect PROFILE=l1`), on the same PR
# as test-reviewer's — 495,561 tokens, 16 tool calls, 52 s: fewer calls
# than test-reviewer's own run, matching plan §5's "poche chiamate, alto
# impatto". TOKEN_BUDGET = this run's total plus one more call's headroom
# at its own per-call cost (495,561 / 16 ≈ 30,973), rounded up: 526,534 →
# 600,000. MAX_TURNS and TIMEOUT_S stay dev-worker's external/plan-
# provenance numbers (docs/adr/0017 §7, §8): this run used 1 of 60 turns
# and 52 of 900 s, so neither is close to binding, and there is no
# separate measurement to replace them with.
MAX_TURNS=60
TIMEOUT_S=900
TOKEN_BUDGET=600000
