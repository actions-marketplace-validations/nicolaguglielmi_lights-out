# Budgets for the release role, an ADK role (docs/adr/0020 §1, §3). HARNESS
# names the AgentHarness adapter this role runs on regardless of the
# profile's AGENT_HARNESS, which selects the coding roles' harness; the
# model is still the profile's (replay at L0). THINKING from plan §5's
# table ("formatta dati che ha già"). TIMEOUT_S: plan §2, the one
# wall-clock figure with provenance (the ADR 0017 §8 precedent). No
# TOKEN_BUDGET yet: run.json records the first real numbers and a
# dedicated commit sets one from them.
HARNESS=adk
THINKING=low
TIMEOUT_S=900
# The model turns one ADK run may take (docs/adr/0090, amendment A1).
# Provenance, decision: twice the measured 2 of both recordings (one
# decision call and its sentence), room for one call the model repeats.
ADK_MAX_TURNS=4
