#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# lights-out: the gates, init, triage and post mortem of lights-out on any
# repository, from the published image, with no clone of lights-out
# (docs/adr/0045). The host needs a container engine (podman or docker)
# and git, nothing else. The plane, the canary and the rollback stay the
# clone's: git clone && ./go demo.
#
#   lights-out init [HEAD=]             draft .lights-out/ for this repository (or that commit), outside it
#   lights-out gates [BASE= HEAD=]      judge the last commit, or a range; STAGED=1 judges what is staged;
#                                       JUDGED="<sha> ..." names trees already judged, whose lines mutation skips (docs/adr/0074)
#   lights-out test-proof [BASE= HEAD=]     only test and test-proof: the tests a change adds fail on its base
#   lights-out test-integrity [BASE= HEAD=] only test-weakening and mutation: no test weakened, mutants killed
#   lights-out triage ALERT=<file>      an alert in, an incident out (PROFILE=l1 and a key on your alerts)
#   lights-out postmortem INCIDENT=<file>   an incident document in, a post mortem and tickets out
#   lights-out doctor                   engine, image, key: one line each, then GO or NO-GO
#   lights-out version
#
# init, gates, test-proof and test-integrity run the gates image,
# ghcr.io/nicolaguglielmi/lights-out-gates; triage and postmortem the full
# one, ghcr.io/nicolaguglielmi/lights-out (docs/adr/0057 §5).
# LIGHTS_OUT_IMAGE, when set, is the image for every command.
# The repository is mounted read-only; what lights-out writes (the init
# draft, the gates' details, incidents, post mortems, tickets) goes to
# LIGHTS_OUT_OUT, default ~/.local/state/lights-out/<repository>. The
# engine socket is never mounted (docs/adr/0045 §3). Keys are read from
# your environment by name, never from a file.
set -eu

version=0.6.0
gates_image=${LIGHTS_OUT_IMAGE:-ghcr.io/nicolaguglielmi/lights-out-gates:$version}
full_image=${LIGHTS_OUT_IMAGE:-ghcr.io/nicolaguglielmi/lights-out:$version}
keys="GEMINI_API_KEY ANTHROPIC_API_KEY OPENAI_API_KEY"

die() { printf 'lights-out: %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n 's/^#   //p' "$0" >&2
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
  init|gates|test-proof|test-integrity|triage|postmortem|doctor|version) ;;
  help|-h|--help) usage; exit 0 ;;
  *) die "unknown command '$cmd'; one of: init gates test-proof test-integrity triage postmortem doctor version" ;;
esac
for a do
  case "$a" in
    BASE=*|HEAD=*|JUDGED=*|STAGED=*|ALERT=*|INCIDENT=*|PROFILE=*|MODEL_PROVIDER=*|MODEL=*) ;;
    *) die "'$a' is not an argument lights-out takes; one of BASE= HEAD= JUDGED= STAGED= ALERT= INCIDENT= PROFILE= MODEL_PROVIDER= MODEL=" ;;
  esac
done

case "$cmd" in
  triage|postmortem) image=$full_image ;;
  *) image=$gates_image ;;
esac

if [ "$cmd" = version ]; then
  printf 'lights-out %s (gates image %s, full image %s)\n' "$version" "$gates_image" "$full_image"
  exit 0
fi

if [ -n "${CONTAINER_ENGINE:-}" ]; then
  engine=$CONTAINER_ENGINE
  command -v "$engine" >/dev/null 2>&1 || die "CONTAINER_ENGINE=$engine is not on PATH"
elif command -v podman >/dev/null 2>&1; then
  engine=podman
elif command -v docker >/dev/null 2>&1; then
  engine=docker
else
  die "no container engine found. Install podman (reference) or docker, or set CONTAINER_ENGINE."
fi

# The key the chosen provider needs, by name; L0 replays and needs none.
profile=${PROFILE:-l0}
model_provider=${MODEL_PROVIDER:-gemini}
for a do
  case "$a" in
    PROFILE=*) profile=${a#PROFILE=} ;;
    MODEL_PROVIDER=*) model_provider=${a#MODEL_PROVIDER=} ;;
  esac
done
case "$model_provider" in
  anthropic) key=ANTHROPIC_API_KEY ;;
  openai) key=OPENAI_API_KEY ;;
  *) key=GEMINI_API_KEY ;;
esac

if [ "$cmd" = doctor ]; then
  bad=""
  item() { printf 'doctor: %-7s %s\n' "$1" "$2" >&2; }
  if "$engine" info >/dev/null 2>&1; then
    item engine "ok, $engine $("$engine" version --format '{{.Client.Version}}' 2>/dev/null || echo '?'), answers"
  else
    item engine "FAIL, $engine does not answer ('$engine info' fails): start it (podman machine start, or the docker daemon)"
    bad="$bad engine"
  fi
  if command -v git >/dev/null 2>&1; then
    item git "ok, $(git --version)"
  else
    item git "FAIL, git is not on PATH"; bad="$bad git"
  fi
  if [ -z "$bad" ] && got=$("$engine" image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$image" 2>/dev/null); then
    item image "ok, $image is here (version ${got:-unlabelled})"
  elif [ -z "$bad" ] && "$engine" manifest inspect "$image" >/dev/null 2>&1; then
    item image "ok, $image is in the registry, pulled on the first run"
  elif [ -z "$bad" ]; then
    item image "FAIL, $image is neither here nor reachable: not published yet, private, or no login (docker login ghcr.io); from a clone, ./go package-gates builds localhost/lights-out-gates:dev for LIGHTS_OUT_IMAGE"
    bad="$bad image"
  fi
  if [ "$profile" = l0 ]; then
    item key "ok, none needed at L0 (recordings replay; on your own alerts and incidents: PROFILE=l1 and a key)"
  elif eval "[ -n \"\${$key:-}\" ]"; then
    item key "ok, $key is set for $model_provider at $profile"
  else
    item key "FAIL, $key is not set in this environment; $model_provider at $profile needs it"
    bad="$bad key"
  fi
  if [ -n "$bad" ]; then
    printf 'NO-GO: doctor —%s\n' "$bad"
    exit 1
  fi
  printf 'GO: doctor\n'
  exit 0
fi

# init and gates judge a repository: run from its top level, whatever the
# subdirectory. triage and postmortem read files under the current one.
case "$cmd" in
  init|gates|test-proof|test-integrity)
    top=$(git rev-parse --show-toplevel 2>/dev/null) || die "lights-out $cmd runs inside a git repository"
    cd "$top" ;;
esac
here=$(pwd -P)
out=${LIGHTS_OUT_OUT:-${XDG_STATE_HOME:-$HOME/.local/state}/lights-out/$(basename "$here")}
mkdir -p "$out" || die "cannot create $out (LIGHTS_OUT_OUT)"
out=$(CDPATH='' cd -- "$out" && pwd -P)

# STAGED=1: the staged changes as this host's git sees them, handed to the
# image as a file. Read through the engine's mount, .git/index can be a
# stale copy right after `git add` (podman machine's file sharing,
# observed 2026-11-08), and the patch would be another change.
rm -f "$out/staged.patch"
for a do
  case "$a" in
    STAGED=0|STAGED=) ;;
    STAGED=*) git diff --cached --binary > "$out/staged.patch" || die "git diff --cached failed in $here" ;;
  esac
done

# SELinux: never :z, which would relabel your repository (docs/adr/0045 §2).
engine_flags="--security-opt label=disable"
if [ "$engine" = docker ]; then
  engine_flags="$engine_flags --user $(id -u):$(id -g) -e HOME=/tmp"
fi
# Passed by name only: the value never appears on a command line.
env_flags=""
for k in $keys MODEL_PROVIDER MODEL; do
  if eval "[ -n \"\${$k:-}\" ]"; then env_flags="$env_flags -e $k"; fi
done

rc=0
# shellcheck disable=SC2086 # flag strings are deliberately word-split
"$engine" run --rm --init -i $engine_flags $env_flags \
  -v "$here:/repo:ro" -v "$out:/out" \
  -e LIGHTS_OUT_HOST_OUT="$out" -e PROFILE="$profile" \
  "$image" "$cmd" "$@" || rc=$?
if [ "$rc" = 125 ]; then
  die "$engine could not start $image (exit 125, see above): not published yet, private, or no login (docker login ghcr.io); from a clone, ./go package-gates (./go package for triage and postmortem) builds one for LIGHTS_OUT_IMAGE"
fi
[ "$rc" = 0 ] || [ "$cmd" = triage ] || [ "$cmd" = postmortem ] || [ "$cmd" = init ] || printf 'lights-out: the details of a NO-GO are above and in %s/gates/\n' "$out" >&2
exit "$rc"
