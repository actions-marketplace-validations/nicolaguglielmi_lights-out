# SPDX-License-Identifier: Apache-2.0
#
# Merge policy for the M4 PR gates (docs/adr/0015, docs/adr/0016).
# KEY=VALUE, one per line. `#` comments must be on their own line — no
# inline comments, no quotes, no shell expansion. Lists are colon-separated
# (an unquoted KEY=a b would be a command in sh, and quoting would need a
# second parser rule). Sourced by gates/*.sh with `.`; parsed the same way
# by core/risk.py, so the classifier runs identically under `make` and
# under `python3 -m unittest`.
#
# This file does not decide promotion. release-freeze is a flag evaluated
# by core/launchpad.sh (docs/adr/0013 §6), not a policy entry; the rules
# for what happens after a review at the go-for-launch gate arrive with
# the control plane (M6).

# --- risk signals (docs/adr/0016 §2) — highest matched signal wins ---

# Renaming any of these paths silently changes risk scoring (docs/adr/0008
# already warned about migrations); core/tests/test_risk.py uses the real
# paths, so a rename fails ci, which is the guard.
RISK_HIGH_MIGRATIONS=app/backend/migrations/*
RISK_HIGH_AUTH=app/backend/meetups/auth.py

# Declared by plan §7; no such file exists in this app today. The rule is
# proven by a synthetic test case (docs/adr/0016 §3), not by app code.
RISK_HIGH_PAYMENTS=app/backend/meetups/payments*.py:app/backend/meetups/billing*.py

# The one signal beyond the plan's four (docs/adr/0016 §2): a PR that edits
# a gate must not be able to merge itself. Kept by owner decision, 2026-09-14.
RISK_HIGH_PLATFORM=gates/*:ci/*:verify/*:core/*:policy/*:.github/*:go:Makefile:workbench/*:adapters/*

# Provenance, external: the low end of the "200-400 lines per review"
# guidance from the SmartBear/Cisco code-review study, the number every
# review handbook repeats — past it, defect detection starts to drop.
# Lockfiles are generated and never read line-by-line by a reviewer.
RISK_SIZE_MEDIUM_LINES=200
RISK_SIZE_EXCLUDE=*.lock:package-lock.json

# low is the only level a PR can auto-merge at; medium and high both mean
# "not auto-merged" today (docs/adr/0016 §4) — what medium and high mean
# beyond that is M6's routing decision.
RISK_AUTO_MERGE_LEVELS=low

# --- mutation gate (docs/adr/0015 §3) ---

# Provenance: measured by `./go mutation-baseline` (whole app/backend/meetups
# package, MUTATION_LINES=all), recorded here the day it is run. Placeholder
# until M4's baseline step; replaced with commit, date, tool version, mutant
# count and wall time, and re-measured only by a dedicated commit.
MUTATION_BASELINE=0.70
# Provenance, decision: one score quantum of the honest-fix fixture (about
# ten mutants on its changed lines, so one equivalent survivor costs ~0.1).
MUTATION_MARGIN=0.10
