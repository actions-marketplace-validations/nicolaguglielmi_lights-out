# The main check's group (docs/adr/0056 §3): how many first-parent commits
# after the last green main are judged as one, and so how many a red group
# bisects. Read by core/mainline.py from the tower's own checkout.
#
# Provenance: the owner's decision recorded in roles/dev-worker/role.env at
# M5 -- four dev-worker attempts per day -- against the Gemini API free
# tier's 250 requests/day (external constraint) at MAX_TURNS=60, the same
# source as REWORK_MAX_ATTEMPTS (docs/adr/0038 §3): at most four merges a
# day reach main through the free-tier tower, so a group never spans more
# than a day of them and bisecting it costs at most two gate runs.
MAINLINE_GROUP_MAX=4
