# The rework loop's cap (docs/adr/0038 §3): how many attempts one ticket
# gets before merge, the first included. Read by core/steps/rework.sh from
# the tower's own checkout, never from the PR it judges.
#
# Provenance, decision: the owner's, recorded in roles/dev-worker/role.env at
# M5 — four dev-worker attempts per day — against the Gemini API free
# tier's 250 requests/day (external constraint) at MAX_TURNS=60: 4 x 60 =
# 240 <= 250, so four full-budget attempts of one ticket fit one day.
REWORK_MAX_ATTEMPTS=4

# The spend budget (docs/adr/0083 §4), in USD: what one ticket, and every
# ticket together in one UTC day, may spend on runs before the tower
# stops launching attempts. Checked by core/tower.py before `assign` and
# `rework`, against the `spend` ledger priced from profiles/prices.json;
# a run of unknown cost stops a set limit. Empty is no limit. A number set
# here carries its own provenance line, like every numeric policy key.
#
# Provenance, decision: the owner's, docs/PLAN.md sprint 2026-11-12, M50:
# empty by default, so ./go demo is unchanged.
SPEND_BUDGET_TICKET_USD=
SPEND_BUDGET_DAY_USD=
