{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lights-out/logbook/1.3",
  "title": "lights-out logbook 1.3",
  "description": "The one document the console reads and a consumer collects (docs/adr/0047 §2, §6; field by field in docs/plans/console.md). Assembled by core/logbook.sh, no clock of its own. An added optional field is a minor version; readers ignore fields they do not know. A source the reader could not read is {ok: false, error}, never a default. 1.1 (docs/adr/0055 §6) adds, all optional: each ticket's feature, priority, questions, product, tasks and timeline, the spec's verdict, line, criteria, by and at; each ticket's wait (ADR 0053's refused assign) and map (ADR 0054); and at the top level kanban, perimeters_held (ADR 0053's perimeters/held) and docs_to_realign (ADR 0054's docs tickets). 1.2 (docs/adr/0059 §3) adds, all optional: the project map's ADRs at the top level (adrs: {map_sha, items}, each with its status, text and the files, tickets and ADRs it is linked to), each ticket's adrs (the ADRs that govern its perimeter's files), and the request row's by and via (docs/adr/0059 §4). 1.3 (docs/adr/0073 §10) adds, optional: agents at the top level, {lines}, what the local contract gives the agents in the wording ./go agents prints, unread when the contract is refused.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "tickets",
    "releases",
    "postmortems",
    "thresholds",
    "launch"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^lights-out/logbook/1\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "required": [
        "commit",
        "level",
        "workload",
        "code_host"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": "string"
        },
        "workload": {
          "type": "string"
        },
        "code_host": {
          "type": "string"
        }
      }
    },
    "tickets": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ticket"
          }
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    },
    "releases": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    },
    "postmortems": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postmortem"
          }
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    },
    "thresholds": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/threshold"
          }
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    },
    "launch": {
      "$ref": "#/$defs/launch"
    },
    "docs_to_realign": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ticket",
              "merge_sha",
              "docs_ticket",
              "docs_ticket_state"
            ],
            "properties": {
              "ticket": {
                "type": "string"
              },
              "merge_sha": {
                "$ref": "#/$defs/str_or_null"
              },
              "docs_ticket": {
                "type": "string"
              },
              "docs_ticket_state": {
                "$ref": "#/$defs/str_or_null"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    },
    "kanban": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "state",
              "tickets"
            ],
            "properties": {
              "state": {
                "type": "string"
              },
              "tickets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    },
    "perimeters_held": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ticket",
              "globs",
              "state",
              "holding"
            ],
            "properties": {
              "ticket": {
                "type": "string"
              },
              "globs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "state": {
                "$ref": "#/$defs/str_or_null"
              },
              "holding": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    },
    "adrs": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "map_sha",
            "items"
          ],
          "properties": {
            "map_sha": {
              "$ref": "#/$defs/str_or_null"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/adr"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    },
    "agents": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "lines"
          ],
          "properties": {
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/unread"
        }
      ]
    }
  },
  "$defs": {
