 app/backend/meetups/geocoder_client.py    |  2 ++
 app/backend/tests/test_geocoder_client.py | 27 +++++++++++++++++++++++
 app/contracts/geocoder/examples.json      |  2 +-
 4 files changed, 31 insertions(+), 2 deletions(-)

