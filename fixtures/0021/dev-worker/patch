From: lights-out-fixtures <fixtures@lights-out.invalid>
Date: Sat, 7 Nov 2026 20:05:03 +0100
Subject: [PATCH] Add a one-line size report of the metrics page
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

meetups/report.py's metrics_report() returns the metrics page's size in
bytes and lines, for the ops runbook; a test checks both numbers on a
page of known size.

Hand-written L0 fixture for ticket 0021 (docs/adr/0056 §7): no model
wrote this change.
---
 app/backend/meetups/report.py    | 9 +++++++++
 app/backend/tests/test_report.py | 6 ++++++
 2 files changed, 15 insertions(+)
 create mode 100644 app/backend/meetups/report.py
 create mode 100644 app/backend/tests/test_report.py

diff --git a/app/backend/meetups/report.py b/app/backend/meetups/report.py
new file mode 100644
index 0000000..a563180
--- /dev/null
+++ b/app/backend/meetups/report.py
@@ -0,0 +1,9 @@
+"""A one-line size report of the metrics page, for the ops runbook."""
+
+from meetups.metrics import metrics_text
+
+
+def metrics_report() -> str:
+    body = metrics_text()
+    lines = body.count(b"\n")
+    return f"{len(body)} bytes, {lines} lines"
diff --git a/app/backend/tests/test_report.py b/app/backend/tests/test_report.py
new file mode 100644
index 0000000..c140729
--- /dev/null
+++ b/app/backend/tests/test_report.py
@@ -0,0 +1,6 @@
+from meetups import report
+
+
+def test_metrics_report_counts_the_page_bytes_and_lines(monkeypatch):
+    monkeypatch.setattr(report, "metrics_text", lambda: b"# HELP x\nx 1\n\n")
+    assert report.metrics_report() == "14 bytes, 3 lines"
