# Stub platform policy for ci/logbook.sh: the shapes core/logbook.py reads,
# not the real defaults. Own-line comments only.
RISK_HIGH_MIGRATIONS=
RISK_HIGH_AUTH=
RISK_HIGH_PAYMENTS=
RISK_HIGH_PLATFORM=gates/*:core/*

# Provenance, external: the low end of a review-size
# guidance.
RISK_SIZE_MEDIUM_LINES=200
RISK_SIZE_EXCLUDE=*.lock
RISK_AUTO_MERGE_LEVELS=low

# A comment before the provenance line is not part of it.
# Provenance, decision: one score quantum of the
#   honest-fix fixture, about ten mutants.
MUTATION_MARGIN=0.10

# This key has a comment above it, but not in the provenance form.
ERROR_RATE_MAX_DELTA=0.01


# Empty in this stub: the reader lists decimal values only, so this
# required key (core/policy.py) stays out of the golden.
LATENCY_P95_MAX_DELTA=
