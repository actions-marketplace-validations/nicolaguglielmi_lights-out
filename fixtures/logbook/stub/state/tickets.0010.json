        "text": "From a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1 Mon Sep 17 00:00:00 2001\nFrom: impl <impl@example.invalid>\nSubject: [PATCH 1/2] notify the first person waiting\n\n---\n app/backend/notify/send.py | 6 ++++++\n 1 file changed, 6 insertions(+)\n\ndiff --git a/app/backend/notify/send.py b/app/backend/notify/send.py\nnew file mode 100644\n--- /dev/null\n+++ b/app/backend/notify/send.py\n@@ -0,0 +1,6 @@\n+def first_waiting(queue):\n+    return queue[0] if queue else None\n+\n+\n+def notify(queue, send):\n+    return send(first_waiting(queue))\n--\nFrom b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2 Mon Sep 17 00:00:00 2001\nFrom: tests <tests@example.invalid>\nSubject: [PATCH 2/2] tests for the notifier, from the ticket alone\n\n---\n tests/test_notify.py | 8 ++++++++\n 1 file changed, 8 insertions(+)\n\ndiff --git a/tests/test_notify.py b/tests/test_notify.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/test_notify.py\n@@ -0,0 +1,8 @@\n+from app.backend.notify.send import notify\n+\n+\n+def test_the_first_waiting_is_told():\n+    told = []\n+    notify([\"ada\", \"bob\"], told.append)\n+    assert told == [\"ada\"]\n+    assert notify([], told.append) is None\n--\n",
