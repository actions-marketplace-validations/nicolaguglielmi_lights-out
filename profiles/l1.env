# L1 Local: L0 plus a Gemini API key in .env (see .env.example).
LEVEL=l1
# The model (docs/adr/0040 §1): MODEL_PROVIDER in gemini|anthropic|openai,
# MODEL its exact id; .env overrides both. The id is the one ADR 0018 pinned.
MODEL_PROVIDER=gemini
MODEL=gemini-3.8-flash
AGENT_HARNESS=gemini-cli
CODE_HOST=gitea
TRACKER=file
EVENT_BUS=pubsub-emulator
STATE_STORE=firestore-emulator
ORCHESTRATOR=inproc
DELIVERY=envoy-canary
METRICS=prometheus
FLAGS=flagd
REGISTRY=zot
