# L2 Cloud: a GCP project with billing, set in .env.
LEVEL=l2
# The model (docs/adr/0040 §1): MODEL_PROVIDER in gemini|anthropic|openai,
# MODEL its exact id; .env overrides both. The id is the one ADR 0018 pinned.
MODEL_PROVIDER=gemini
MODEL=gemini-3.8-flash
AGENT_HARNESS=gemini-cli
CODE_HOST=github
TRACKER=github-issues
EVENT_BUS=pubsub
STATE_STORE=firestore
ORCHESTRATOR=inproc
DELIVERY=cloud-deploy
METRICS=managed-prometheus
FLAGS=flagd
REGISTRY=artifact-registry
