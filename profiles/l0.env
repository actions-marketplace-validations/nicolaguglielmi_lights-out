# L0 Replay: podman, no key, no account. Adapter names are directory names under adapters/.
LEVEL=l0
# No model at L0: the roles replay recorded responses, and the two keys
# below are read by nobody (docs/adr/0040 §1).
MODEL_PROVIDER=
MODEL=
AGENT_HARNESS=replay
CODE_HOST=gitea
TRACKER=file
EVENT_BUS=pubsub-emulator
STATE_STORE=firestore-emulator
ORCHESTRATOR=inproc
DELIVERY=envoy-canary
METRICS=prometheus
FLAGS=flagd
REGISTRY=zot
# The project map's slice in the worker's brief (docs/adr/0054 §5): off at
# every level until M24 measures it; one run turns it on with MAP_BRIEF=on.
MAP_BRIEF=off
