# Copy to .env (gitignored). Loaded after the profile. L0 needs none of this.
# Any level, optional: the host port the app answers on, when 8080 is taken.
# APP_PORT=9000
# L1: the key of the provider you pick (docs/adr/0040). The profile picks
# Gemini and gemini-3.8-flash; its free tier is the only free path at L1.
# To run the ADK roles on another provider, set both lines and that key;
# the coding roles take AGENT_HARNESS=claude-code with anthropic, or
# AGENT_HARNESS=codex with openai (gemini-cli goes with gemini).
# MODEL_PROVIDER=anthropic
# MODEL=claude-sonnet-5-5
# MODEL_PROVIDER=openai
# MODEL=gpt-6.1-sol
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me
# Anthropic: https://platform.claude.com/ (paid per run)
ANTHROPIC_API_KEY=replace-me
# OpenAI: https://platform.openai.com/api-keys (paid per run)
OPENAI_API_KEY=replace-me
# Any level, optional: judge your own metrics. ./go verify METRICS_URL=… runs
# verify/slo.sh against any Prometheus-compatible endpoint (docs/adr/0044).
# The auth header is one line, e.g. Authorization: Bearer <token>; it is
# never printed. The plane's own judge ignores both.
METRICS_URL=
METRICS_AUTH_HEADER=
# L1, optional: an attached repository of yours on GitHub as the code host
# (docs/adr/0043). Choose it on the command line, never here:
# ./go e2e CODE_HOST=github PROFILE=l1 (here it would redirect ./go demo,
# whose bundled app GitHub refuses). GITHUB_REPO is <owner>/<name>; the
# token is a fine-grained one granted only that repository: Contents,
# Pull requests and Commit statuses, read and write. Read by lights-out's
# own scripts only, never written to a .git/config, never handed to the
# model's container.
GITHUB_REPO=
GITHUB_TOKEN=
# L2 and L3: a GCP project with billing enabled
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=europe-west1
