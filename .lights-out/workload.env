# lights-out's own contract (docs/adr/0049): the twelve keys the platform
# reads (docs/adr/0030 §2, 0042 §1), the ones its self-judgement job
# (.github/workflows/self.yml) judges every push and pull request with.
# Written by hand: `lights-out init` on this repository NO-GOes, "no stack
# found", because there is no pyproject.toml or package.json at the root
# (run 42033682939 on Actions, 2026-11-05). The gates half only: the
# plane keys are empty, lights-out's plane runs app/, not itself. Paths
# are relative to the repository's root. KEY=VALUE, one per line, no
# inline comments, no `$` or `#` in a value.

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7).
CANARY_VERSION=

# Provenance, measurement: MUTATION_CMD below with MUTATION_LINES=all, the
# committed .lights-out/runners/mutation.sh (cosmic-ray 8.7.0, core/ with
# its tests excluded), in the lights-out image on Actions, 2026-11-05, at
# 957b261 (run 42035898400, job "baseline"): 1327 mutants, 522 killed,
# 805 survived (431 in init.py, 301 in postmortem.py, 42 in risk.py, 31
# in policy.py), score 0.3934, 344 s. The same numbers as run 42033682939
# with the runner patched by hand. Low because postmortem.py has no unit
# test (ci/postmortem.sh drives it end to end) and init.py's version
# parsers are tested on few cases. Re-measured only by a dedicated commit,
# when the suite or the tool changes.
MUTATION_BASELINE=0.3934

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7).
WORKLOAD_KILL_SWITCH=

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7).
WORKLOAD_SAMPLE_PATH=

# Provenance, inferred: every lockfile git tracks here (`git ls-files` for
# uv.lock and package-lock.json, 2026-11-05): the workbench's, the three
# harnesses', the bundled app's, the stacks' runners and the two example
# workloads'. A new lockfile joins by a commit to this line.
WORKLOAD_LOCKFILES=workbench/uv.lock:adapters/claude-code/package-lock.json:adapters/codex/package-lock.json:adapters/gemini-cli/package-lock.json:app/backend/uv.lock:app/frontend/package-lock.json:stacks/python/runners/uv.lock:stacks/javascript/runners/package-lock.json:workloads/minimal/uv.lock:workloads/minimal-js/package-lock.json:workloads/minimal-js/.lights-out/runners/package-lock.json

# Provenance, decision: core/, the Python that decides (risk.py, policy.py,
# init.py, postmortem.py), with a unit suite of its own. One path is all
# the key holds; the rest of the repository's Python and all of its shell
# are outside mutation (docs/adr/0049).
WORKLOAD_MUTATION_SCOPE=core/

# Provenance, inferred: core/ sits at the repository root, nothing to strip.
WORKLOAD_TEST_ROOT=

# The test files (docs/adr/0053 §1): core/'s unittest suite, what the
# mutation command runs. The ci/ checks are not here: they are the suite
# TEST_CMD runs whole, and they change with the code they check.
WORKLOAD_TEST_PATHS=core/tests/*.py

# Provenance, external: the lights-out image refuses any other form (it never
# gets the engine socket, docs/adr/0045 §3), and the self-checks need its
# toolchain: shellcheck, actionlint, gitleaks, docker-compose, python3.
TOOLCHAIN_IMAGE=workbench

# Provenance, decision: the thirty self-checks `./go ci` runs, unit tests
# included, through .lights-out/runners/self-checks.sh (docs/adr/0049).
TEST_CMD=sh .lights-out/runners/self-checks.sh

# Provenance, decision: bandit over core/, tests excluded, the python stack's
# runner. Elsewhere bandit finds 1 issue in adapters/ and 3 in board/
# today (run 42033682939): outside the scope until they are triaged.
SAST_CMD=sh .lights-out/runners/sast.sh core

# Provenance, decision: the python stack's cosmic-ray runner over core/, the
# unit suite stopped at its first failure per mutant.
MUTATION_CMD=sh .lights-out/runners/mutation.sh core "python3 -m unittest discover -s core/tests -t . -f"
