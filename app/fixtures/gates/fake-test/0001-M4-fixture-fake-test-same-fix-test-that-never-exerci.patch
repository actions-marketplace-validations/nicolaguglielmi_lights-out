+++ b/app/backend/meetups/geocoder_client.py
@@ -23,6 +23,11 @@ def geocode(venue: str) -> tuple[float | None, float | None]:
         raise GeocoderUnavailable(str(exc)) from exc
     if response.status_code >= 500:
         raise GeocoderUnavailable(f"status {response.status_code}")
+    if response.status_code == 404:
+        # Unknown venue (ticket 0001): the fake, like a real Nominatim
+        # answering with 200 [], means "no result", not "dependency
+        # broken". Treated exactly like an empty result list below.
+        return None, None
     results = response.json()
     if not results:
         return None, None
