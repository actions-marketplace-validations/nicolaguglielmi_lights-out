+def test_unknown_venue_returns_201_with_null_coordinates(client, geocoder_server):
+    # Ticket 0001: an unknown venue means the meetup is still created, with
+    # null coordinates. "Nowhere, Atlantis" is the contract's pre-existing
+    # 200 [] example (empty result list) -- already covered before this
+    # ticket, and not the new 404 path this ticket adds.
+    token = _signup_and_login(client, "unknown-venue@example.com")
+    create = client.post(
+        "/api/meetups",
+        json={
+            "title": "Somewhere else",
+            "starts_at": "2026-03-01T18:00:00Z",
+            "venue": "Nowhere, Atlantis",
+            "capacity": 5,
+        },
+        headers=_auth(token),
+    )
+    assert create.status_code == 201
+    body = create.json()
+    assert body["venue_lat"] is None
+    assert body["venue_lon"] is None
+
