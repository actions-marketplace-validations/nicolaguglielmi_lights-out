test_meetups.py's happy-path test no longer checks venue_lon. The suite
still passes; the test asserts less than it did. gates/test-weakening.sh
counts one assertion removed and none added in that file, and no ticket
declares the removal (docs/adr/0053 §3).
---
 app/backend/tests/test_meetups.py | 1 -
 1 file changed, 1 deletion(-)

diff --git a/app/backend/tests/test_meetups.py b/app/backend/tests/test_meetups.py
index c0abc84..505a6d4 100644
--- a/app/backend/tests/test_meetups.py
+++ b/app/backend/tests/test_meetups.py
@@ -29,7 +29,6 @@ def test_full_happy_path(client, geocoder_server):
     body = create.json()
     meetup_id = body["id"]
     assert body["venue_lat"] == pytest.approx(45.4641)
-    assert body["venue_lon"] == pytest.approx(9.1919)
 
     listing = client.get("/api/meetups")
     assert listing.status_code == 200
