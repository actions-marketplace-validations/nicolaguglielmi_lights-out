{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "outage": {
      "state": "ENABLED",
      "variants": {
        "on": true,
        "off": false
      },
      "defaultVariant": "off",
      "targeting": {
        "if": [{ "==": [{ "var": "version" }, "0.2.0-outage"] }, "on", "off"]
      }
    },
    "release-freeze": {
      "state": "ENABLED",
      "variants": {
        "on": true,
        "off": false
      },
      "defaultVariant": "off"
    }
  }
}
